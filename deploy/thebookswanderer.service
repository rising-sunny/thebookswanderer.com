[Unit]
Description=The Books Wanderer API (FastAPI)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/thebookswanderer.com/server
EnvironmentFile=/var/www/thebookswanderer.com/server/.env
ExecStart=/var/www/thebookswanderer.com/server/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8010
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
