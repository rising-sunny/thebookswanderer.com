[Unit]
Description=The Books Wanderer API (FastAPI)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/thebookswanderer.com/server
EnvironmentFile=/var/www/thebookswanderer.com/server/.env
# systemd copies the root-only key into the service's private credentials directory.
LoadCredential=prodigi_api_key:/etc/tbw-prodigi/api_key
Environment=PRODIGI_API_KEY_FILE=%d/prodigi_api_key
Environment=PRODIGI_ORDERS_ENABLED=1
# --timeout-graceful-shutdown 0: /admin/live/stream is a Server-Sent Events
# endpoint that holds its connection open by design, so uvicorn's default
# graceful shutdown waits for a client that never disconnects. That left the
# service in "deactivating" on every deploy — nginx returning 502 to real
# visitors, and the deploy's ssh session hanging on the same stuck restart.
# --timeout-keep-alive 0 stops idle keep-alive sockets doing the same.
# Same flags mathrelaxing.store already runs with.
ExecStart=/var/www/thebookswanderer.com/server/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8010 --timeout-keep-alive 0 --timeout-graceful-shutdown 0
Restart=always
RestartSec=3
TimeoutStopSec=15
KillMode=mixed

[Install]
WantedBy=multi-user.target
