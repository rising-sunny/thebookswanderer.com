APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
PUBLIC_BASE_URL=https://thebookswanderer.com

# CJ Dropshipping API Key (My CJ → Authorization → API)
# Docs in-repo: server/docs/cj-api/README.md  |  client: server/services/cj.py
CJ_API_KEY=CJ0000000@api@xxxxxxxx

# Retail pricing:
#   formula P = (cost + PAYPAL_FIXED + OPS_FIXED) / (1 - PAYPAL_PCT - MARGIN_PCT)
#   round up to .99, then raise to cost-band floor (so low-CJ SKUs don't all share one price)
# Bands: cost < T1 → BAND1; < T2 → BAND2; < T3 → BAND3; else formula (+ MIN)
PRICE_MARGIN_PCT=0.40
PAYPAL_FEE_PCT=0.0349
PAYPAL_FEE_FIXED=0.49
PRICE_OPS_FIXED=0.35
PRICE_MIN_USD=6.99
PRICE_BAND_T1=1.00
PRICE_BAND_T2=2.00
PRICE_BAND_T3=4.00
PRICE_BAND1_USD=7.99
PRICE_BAND2_USD=8.99
PRICE_BAND3_USD=9.99
MARKUP_MULTIPLIER=2.4
# Shipping is separate at checkout: retail_ship = cj_freight * SHIPPING_MARKUP
SHIPPING_MARKUP=1.15

# PayPal (same pattern as mathrelaxing.store)
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=live
PAYPAL_WEBHOOK_ID=

# CJ order after PayPal capture:
# 3 = create order only (no balance charge) — good for first tests
# 2 = pay from CJ wallet balance and fulfill
CJ_PAY_TYPE=3

# ── Meta Pixel + Conversions API (Purchase, server-side) ────────────
# Events Manager → dataset → Settings → Conversions API → Generate token.
# Leave META_CAPI_TOKEN empty to disable (checkout still works).
META_PIXEL_ID=
META_CAPI_TOKEN=
# META_CAPI_TEST_CODE=TEST1234   # only while testing in Events Manager

# ── Facebook Page posts (server/scripts/fb_post.py) ─────────────────
# Organic feed only (not Meta Ads MCP). Docs: server/docs/FACEBOOK.md
# Graph Explorer → pages_manage_posts + pages_read_engagement →
#   GET /me/accounts → Page token (long-lived preferred).
# TBW Page ID (Business Suite asset): 1200587819810293
FB_PAGE_ID=1200587819810293
FB_PAGE_TOKEN=
# Smoke:  python scripts/fb_post.py whoami
# Product: python scripts/post_product_fb.py hollow-kitten-bookmark --dry-run

# ── Transactional email (SMTP) ──────────────────────────────────────
# Used for: order confirmation, fulfillment started, shipped, cart reminder.
# Leave SMTP_HOST empty to disable (checkout still works; mails are skipped).
#
# Examples:
#   Resend:   SMTP_HOST=smtp.resend.com  PORT=587  USER=resend  PASS=<api-key>
#   Gmail:    SMTP_HOST=smtp.gmail.com   PORT=587  USER=you@gmail.com  PASS=<app-password>
#   SES:      SMTP_HOST=email-smtp.<region>.amazonaws.com  PORT=587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=1
# SMTP_SSL=1          # use instead of STARTTLS (port 465)
MAIL_FROM=orders@thebookswanderer.com
MAIL_FROM_NAME=The Books Wanderer
MAIL_REPLY_TO=hello@thebookswanderer.com
# Shop owner notification for each paid order (buyer, origin, items, total).
# Comma-separated if multiple. Customer still gets their own confirmation to order email.
MAIL_NOTIFY_TO=estebannavarro.rojo@gmail.com
MAIL_SHOP_NAME=The Books Wanderer

# ── Live admin dashboard (/admin/live) ────────────────────────────────
# Self-hosted traffic / cart / checkout / sales feed (no third-party trackers).
LIVE_ADMIN_USER=tbw
LIVE_ADMIN_PASSWORD=change-me-to-a-strong-password
# Optional: comma-separated owner IPs to exclude from stats
# LIVE_IGNORE_IPS=1.2.3.4
# LIVE_EVENT_RETENTION_DAYS=365
